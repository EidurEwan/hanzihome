{
  "name": "hanzihome-desktop",
  "version": "0.1.4",
  "private": true,
  "description": "HanziHome on the desktop: reads Chinese off the screen with Windows OCR",
  "author": "Eidur Ewan",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:ocr": "node ocr/build.js",
    "test:ocr": "node ocr/build.js render && node test/ocr.js",
    "test:protect": "electron test/protect.js",
    "test:overlay": "electron test/overlay.js",
    "test:hover": "electron test/hover.js",
    "test:text": "electron test/text.js",
    "dist": "node ocr/build.js && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "app.hanzihome.desktop",
    "productName": "HanziHome",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "src/**",
      "assets/**",
      "data/**",
      "ocr/bin/hanzi-ocr.exe",
      "ocr/bin/common.txt"
    ],
    "asarUnpack": [
      "ocr/bin/**"
    ],
    "extraResources": [
      {
        "from": "../site",
        "to": "site"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "assets/icon-256.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "EidurEwan",
        "repo": "hanzihome",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "artifactName": "HanziHome-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
