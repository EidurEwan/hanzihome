{
  "manifest_version": 3,
  "name": "HanziHome",
  "version": "0.1.0",
  "description": "Colours the Chinese on every page by what you know, and shows HanziHome's word popup while you hold Ctrl.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "hz-init.js",
      "hz/index.js",
      "hz/readings.js",
      "hz/readerwords.js",
      "hz/textstory.js",
      "hz/learn.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "HanziHome",
    "default_popup": "action.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://eidurewan.github.io/hanzihome/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://eidurewan.github.io/hanzihome/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "hanzihome@eidurewan.github.io",
      "strict_min_version": "140.0"
    }
  }
}
