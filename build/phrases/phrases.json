[
{"id":"greetings","glyph":"你","colour":"yellow","title":"Greetings and basics","blurb":"The first things you say, and the first things you're asked.",
 "phrases":[["你好！","Hello!"],["谢谢！","Thank you!"],["不客气。","You're welcome."],["对不起。","Sorry."],["没关系。","It's OK.","The usual reply to 对不起."],["再见！","Goodbye!"],["早上好！","Good morning!"],["晚安。","Good night."],["请问。","Excuse me.","Say it before you ask someone a question."],["好久不见！","Long time no see!"]],
 "qa":[["你好吗？","How are you?",[["我很好，谢谢。","I'm fine, thanks."],["还可以。","Not bad."]]],["你叫什么名字？","What's your name?",[["我叫小明。","My name is Xiaoming."],["我叫小红。","My name is Xiaohong."]]],["你是哪国人？","Where are you from?",[["我是英国人。","I'm British."],["我是美国人。","I'm American."]]],["你会说中文吗？","Can you speak Chinese?",[["会一点儿。","A little."],["不太会。","Not really."]]],["你听得懂吗？","Can you understand?",[["听得懂。","Yes, I understand."],["听不懂。","No, I don't understand."]]]]},
{"id":"smalltalk","glyph":"聊","colour":"sky","title":"Small talk","blurb":"Keeping a conversation going.",
 "phrases":[["今天天气真好。","The weather is lovely today."],["太冷了！","It's so cold!"],["你说得对。","You're right."],["真的吗？","Really?"],["我也是。","Me too."],["没问题。","No problem."],["等一下。","Wait a moment."],["我不知道。","I don't know."],["我明白了。","I see."],["慢慢来。","Take your time."]],
 "qa":[["你住在哪儿？","Where do you live?",[["我住在北京。","I live in Beijing."],["我住在上海。","I live in Shanghai."]]],["你今年多大？","How old are you?",[["我二十五岁。","I'm twenty-five."],["这是秘密！","That's a secret!"]]],["你周末做什么？","What do you do at the weekend?",[["我在家休息。","I rest at home."],["我跟朋友出去玩。","I go out with friends."]]],["你吃了吗？","Have you eaten?",[["吃了，你呢？","Yes, have you?"],["还没呢。","Not yet."]],"Often just a friendly hello, not an invitation."],["今天天气怎么样？","What's the weather like today?",[["很好。","It's nice."],["下雨了。","It's raining."]]]]},
{"id":"food","glyph":"吃","colour":"pink","title":"Food and drink","blurb":"Ordering, eating and paying.",
 "phrases":[["我饿了。","I'm hungry."],["我渴了。","I'm thirsty."],["太好吃了！","It's so delicious!"],["服务员！","Excuse me, waiter!"],["请给我菜单。","Please give me the menu."],["我要这个。","I'd like this one."],["不要辣的。","Nothing spicy, please."],["买单。","The bill, please."],["干杯！","Cheers!"],["我吃饱了。","I'm full."]],
 "qa":[["你想吃什么？","What would you like to eat?",[["我想吃面条。","I'd like noodles."],["什么都可以。","Anything is fine."]]],["你要喝什么？","What would you like to drink?",[["来一杯茶。","A cup of tea, please."],["我要一杯水。","I'd like a glass of water."]]],["这个辣吗？","Is this spicy?",[["有点儿辣。","A bit spicy."],["不辣。","It's not spicy."]]],["几位？","How many people?",[["两位。","Two people."],["就我一个人。","Just me."]],"What staff ask as you walk into a restaurant."],["味道怎么样？","How does it taste?",[["非常好吃。","It's really good."],["有点儿咸。","It's a bit salty."]]]]},
{"id":"work","glyph":"工","colour":"mint","title":"Work","blurb":"Around the office and your job.",
 "phrases":[["我在上班。","I'm at work."],["我今天要加班。","I have to work overtime today."],["我下班了。","I've finished work."],["开会了。","The meeting is starting."],["我很忙。","I'm very busy."],["辛苦了！","Thanks for your hard work!","A warm thing to say to someone who has worked hard."],["我明天请假。","I'm taking tomorrow off."],["这个工作很累。","This job is tiring."],["老板来了！","The boss is here!"],["请发给我。","Please send it to me."]],
 "qa":[["你做什么工作？","What do you do for work?",[["我是老师。","I'm a teacher."],["我在一家公司工作。","I work at a company."]]],["你几点下班？","What time do you finish work?",[["六点。","Six o'clock."],["今天要很晚。","Very late today."]]],["这个什么时候要？","When is this needed?",[["明天早上。","Tomorrow morning."],["越快越好。","The sooner the better."]]],["你能帮我看一下吗？","Could you take a look for me?",[["当然可以。","Of course."],["我现在没空。","I'm not free right now."]]],["开会了吗？","Has the meeting started?",[["还没有。","Not yet."],["已经开始了。","It has already started."]]]]},
{"id":"shopping","glyph":"买","colour":"yellow","title":"Shopping and money","blurb":"Asking the price, and asking for a better one.",
 "phrases":[["太贵了！","That's too expensive!"],["便宜一点儿吧。","Make it a bit cheaper."],["我只是看看。","I'm just looking."],["我买这个。","I'll buy this one."],["我不要了。","I don't want it any more."],["能试一下吗？","Can I try it?"],["请给我一个袋子。","Please give me a bag."],["这个很漂亮。","This is beautiful."],["我没带钱。","I didn't bring any money."],["今天打折。","There's a discount today."]],
 "qa":[["这个多少钱？","How much is this?",[["二十块。","Twenty yuan."],["一百块。","A hundred yuan."]]],["你要几个？","How many do you want?",[["两个。","Two."],["就一个。","Just one."]]],["可以用手机付吗？","Can I pay by phone?",[["可以。","Yes, you can."],["不行，只要现金。","No, cash only."]]],["有大一点儿的吗？","Do you have a bigger one?",[["有，你等一下。","Yes, wait a moment."],["没有了。","We don't have any more."]]],["还要别的吗？","Anything else?",[["不要了，谢谢。","No, thanks."],["再来一个。","One more, please."]]]]},
{"id":"travel","glyph":"路","colour":"sky","title":"Travel and directions","blurb":"Getting there, and finding your way when you don't.",
 "phrases":[["我迷路了。","I'm lost."],["请带我去机场。","Please take me to the airport."],["在这儿停车。","Stop here, please."],["我要去火车站。","I'm going to the train station."],["往左走。","Go left."],["往右走。","Go right."],["一直走。","Go straight on."],["太远了。","It's too far."],["我要一张票。","I'd like one ticket."],["我到了。","I've arrived."]],
 "qa":[["洗手间在哪儿？","Where is the toilet?",[["在那边。","Over there."],["往前走，然后左转。","Go ahead, then turn left."]]],["去机场怎么走？","How do I get to the airport?",[["坐地铁最快。","The subway is fastest."],["坐出租车吧。","Take a taxi."]]],["地铁站远吗？","Is the subway station far?",[["不远，走五分钟。","Not far, a five-minute walk."],["很远，要坐车。","It's far, you'll need a ride."]]],["什么时候到？","When do we arrive?",[["马上就到。","Very soon."],["还有十分钟。","Ten more minutes."]]],["这个位子有人吗？","Is this seat taken?",[["没有，请坐。","No, please sit."],["有人。","Yes, it is."]]]]},
{"id":"entertainment","glyph":"玩","colour":"pink","title":"Entertainment","blurb":"Films, music, games and nights out.",
 "phrases":[["这部电影真好看。","This film is really good."],["我喜欢这首歌。","I like this song."],["我们去看电影吧。","Let's go and see a film."],["我在追剧。","I'm following a TV series."],["别剧透！","No spoilers!"],["这个游戏很好玩。","This game is really fun."],["音乐太大声了。","The music is too loud."],["我是他的粉丝。","I'm a fan of his."],["周末去唱歌吧。","Let's go singing at the weekend.","Singing usually means karaoke."],["太无聊了。","It's so boring."]],
 "qa":[["你喜欢看什么电影？","What films do you like?",[["我喜欢看喜剧。","I like comedies."],["什么都看。","I watch anything."]]],["你玩游戏吗？","Do you play games?",[["玩，每天都玩。","Yes, every day."],["不玩，没时间。","No, I don't have time."]]],["这部电影怎么样？","How is this film?",[["很好看。","It's very good."],["没意思。","It's dull."]]],["晚上有什么节目？","What's on tonight?",[["我们去唱歌吧。","Let's go singing."],["在家看电视。","Watching TV at home."]]],["你喜欢听什么歌？","What songs do you like?",[["我喜欢听老歌。","I like old songs."],["我什么歌都听。","I listen to all kinds."]]]]},
{"id":"humour","glyph":"笑","colour":"mint","title":"Humour","blurb":"Jokes, teasing and a little internet slang.",
 "phrases":[["哈哈哈！","Hahaha!"],["笑死我了！","I'm dying of laughter!"],["开玩笑的。","Just kidding."],["别逗了。","Stop joking."],["你真逗。","You're so funny."],["我太难了。","Life is so hard for me.","An internet joke, said about small troubles."],["我只是来吃瓜的。","I'm just here for the gossip.","Literally \"here to eat melon\": slang for watching drama from the sidelines."],["我信你个鬼！","Yeah right, as if I believe you!"],["这也太离谱了吧！","That's ridiculous!"],["我今天躺平了。","I'm doing nothing today.","Literally \"lying flat\": slang for opting out of the rat race."]],
 "qa":[["你在开玩笑吧？","You're joking, right?",[["没有，我是认真的。","No, I'm serious."],["哈哈，被你发现了。","Haha, you caught me."]]],["你为什么笑？","Why are you laughing?",[["太好笑了！","It's too funny!"],["我也不知道。","I don't know either."]]],["你减肥了吗？","Have you gone on a diet?",[["明天开始。","Starting tomorrow."],["吃饱了才有力气减肥。","You need a full stomach for the strength to diet."]]],["你怎么又迟到了？","Why are you late again?",[["我的床不让我走。","My bed wouldn't let me leave."],["路上堵车，真的！","There was traffic, honestly!"]]],["你会做饭吗？","Can you cook?",[["我会点外卖。","I can order takeaway."],["会，我会煮水。","Yes, I can boil water."]]]]},
{"id":"feelings","glyph":"心","colour":"yellow","title":"Feelings and friends","blurb":"Saying how you feel, and looking out for each other.",
 "phrases":[["我很高兴。","I'm very happy."],["我好累。","I'm so tired."],["我很想你。","I miss you."],["别担心。","Don't worry."],["加油！","You can do it!","Literally \"add oil\": cheering someone on."],["太棒了！","That's great!"],["真可惜。","What a pity."],["我生气了。","I'm angry."],["你真好。","You're so kind."],["恭喜！","Congratulations!"]],
 "qa":[["你怎么了？","What's wrong?",[["没事。","Nothing."],["我今天心情不好。","I'm in a bad mood today."]]],["你开心吗？","Are you happy?",[["很开心！","Very happy!"],["还行吧。","It's OK, I suppose."]]],["你有空吗？","Are you free?",[["有，怎么了？","Yes, what's up?"],["今天没空，明天吧。","Not today, maybe tomorrow."]]],["一起吃饭吧？","Shall we eat together?",[["好啊！","Sure!"],["下次吧。","Next time."]]],["你生气了吗？","Are you angry?",[["没有，我没生气。","No, I'm not angry."],["有一点儿。","A little."]]]]},
{"id":"health","glyph":"医","colour":"sky","title":"Health","blurb":"For when you're not feeling your best.",
 "phrases":[["我不舒服。","I don't feel well."],["我头疼。","I have a headache."],["我感冒了。","I have a cold."],["我发烧了。","I have a fever."],["我要看医生。","I need to see a doctor."],["请叫救护车！","Please call an ambulance!"],["我肚子疼。","I have a stomach ache."],["多喝水。","Drink plenty of water."],["好好休息。","Get some good rest."],["早点儿睡。","Go to bed early."]],
